# ─────────────────────────────────────────────────────────────
#  .env.production — Production muhit o'zgaruvchilari
#  Bu faylni to'ldirib serverga yuboring (git'ga yuklamang!)
# ─────────────────────────────────────────────────────────────

# ── Django ────────────────────────────────────────────────────
# Yangi key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_SECRET_KEY_AT_LEAST_50_CHARS

DEBUG=False

# Serveringiz IP yoki domen nomi (vergul bilan ajratilgan)
ALLOWED_HOSTS=yourdomain.uz,www.yourdomain.uz

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://yourdomain.uz,https://www.yourdomain.uz

# ── PostgreSQL ────────────────────────────────────────────────
DB_NAME=uzyolkprik
DB_USER=uzyolkprik_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_DATABASE_PASSWORD
DB_HOST=db
DB_PORT=5432

# ── Gunicorn ──────────────────────────────────────────────────
# Workers = (2 * CPU sonlar) + 1
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=warning
